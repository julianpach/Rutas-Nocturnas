    "import folium\n",
    "puntos = {\"Sede\": (4.6097, -74.0817), \"Empleado A\": (4.6480, -74.0630), \"Empleado B\": (4.5981, -74.1400)}\n",
    "m = folium.Map(location=(4.62, -74.09), zoom_start=12)\n",
